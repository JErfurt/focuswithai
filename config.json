{
    "debug_level": 3,
    
    "target_apps" : [
        "Unity", "Visual Studio Code", "Android Studio", "Supabase", "FlutterFlow", "Code", "PyCharm", "Sublime Text"
    ],
    "reminder_interval" : 30,
    "punishment_interval" : 60,
    "praise_interval" : 1800,

    "interesting_fact_interval" : 300,
    
    "edge_tts_voice" : "ru-RU-SvetlanaNeural",
    "reminder_sound" : "H_WARNING.mp3",
    
    "prompt" : "You are helpfull assistant",
    "punishment_subprompt" : "\n\nUser: Я отвлекся от своей работы в окне '{}' и переключился на '{}' без нужды.\nЕва:",
    "praise_subprompt" : "\n\nUser: Я работал сфокусированно в окне '{}' без отвлечений целых '{}' секунд!\nЕва:",
    "interesting_fact_subprompt": "\n\nUser: Расскажи мне бредовый факт\nЕва:",
    
    "discord_presence" : false,

    "stream": false,
    "n_predict": 400,
    "temperature": 0.7,
    "stop": ["</s>", "Ева:", "User:", "Eva:", "\n\n"],
    "repeat_last_n": 256,
    "repeat_penalty": 1.18,
    "penalize_nl": false,
    "top_k": 40,
    "top_p": 0.95,
    "min_p": 0.05,
    "tfs_z": 1,
    "typical_p": 1,
    "presence_penalty": 0,
    "frequency_penalty": 0,
    "mirostat": 0,
    "mirostat_tau": 5,
    "mirostat_eta": 0.1,
    "grammar": "",
    "n_probs": 0,
    "min_keep": 0,
    "image_data": [],
    "cache_prompt": true,
    "api_key": "",
    
    "google_assistant_api_key": "",
    "google_project_id": "",
    "google_max_tokens": 400,
    "google_temperature": 0.7,
    "google_top_p": 0.95,
    "google_top_k": 40
}